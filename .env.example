# Copy this file to .env (git-ignored) and fill in real values.
# Never commit an actual .env file — see GITHUB_MIGRATION_NOTES.md.

# ── API server (artifacts/api-server) ──────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/opportunitygenie

# Port the API server listens on.
PORT=5000

# Password for the single admin account used by the admin dashboard.
# Pick something long and random — this is the only thing gating write
# access to your scholarships and settings.
ADMIN_PASSWORD=change-me

# Secret used to sign admin session tokens. Any long random string works,
# e.g. `openssl rand -hex 32`. Changing this instantly logs out all admins.
ADMIN_TOKEN_SECRET=change-me-too

# ── Admin dashboard (artifacts/admin) ──────────────────────────────────────
# Base URL of the API server the dashboard talks to. Leave empty if the
# dashboard is served from the same origin as the API.
VITE_API_BASE_URL=http://localhost:5000

# ── Mobile app (artifacts/mobile) ──────────────────────────────────────────
# Base URL of the API server. Must start with EXPO_PUBLIC_ to be inlined
# into the Expo client bundle (Expo strips all other env vars from builds).
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# AdMob native "App IDs" (one per platform) — baked into the app at build
# time by the react-native-google-mobile-ads config plugin (see
# artifacts/mobile/app.config.js). These are NOT the same as ad unit IDs:
# ad unit IDs (banner/interstitial/rewarded) are managed from the admin
# dashboard's Settings page instead, and can be changed without a rebuild.
# Leave unset during development — Google's public test App IDs are used
# automatically.
ADMOB_APP_ID_IOS=
ADMOB_APP_ID_ANDROID=
